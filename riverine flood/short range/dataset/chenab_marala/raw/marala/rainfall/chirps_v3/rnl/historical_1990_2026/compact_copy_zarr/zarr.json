      "cdh": {
        "domain": [
          "climate"
        ],
        "usage": {
          "intended_uses": [
            "seasonal rainfall monitoring and anomaly analysis",
            "drought and dry-spell indices over data-sparse regions",
            "climate inputs for crop and hydrological models",
            "bounding-box time-series extraction via an API"
          ],
          "not_recommended_for": [
            {
              "use": "station-level precipitation measurement",
              "reason": "values are satellite-based estimates blended with a station climatology, not gauge observations; local totals can differ substantially from any individual station",
              "use_instead": "national meteorological service gauge records"
            },
            {
              "use": "sub-daily or hourly rainfall analysis",
              "reason": "the product is a daily total and carries no diurnal information"
            },
            {
              "use": "trend analysis across the full record without care",
              "reason": "the density of contributing stations varies through time and between countries, so apparent trends can reflect changes in input data rather than climate"
            }
          ]
        }
      },
