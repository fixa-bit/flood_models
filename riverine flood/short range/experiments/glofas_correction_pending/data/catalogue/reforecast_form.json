    "css": "todo",
    "type": "StringChoiceWidget",
    "details": {
      "values": [
        "grib2",
        "netcdf"
      ],
      "columns": 2,
      "labels": {
        "grib2": "GRIB2",
        "netcdf": "NetCDF-4 (Experimental)"
      },
      "default": [
        "grib"
      ]
    },
    "id": "data_format"
  },
  {
    "name": "download_format",
    "label": "Download format",
    "help": "Please note that in some circumstance the conversion from GRIB to NetCDF can result in multiple files. <br><br> If you select 'Zip' the files will always be zipped into a single file. <br><br> If you select 'Unarchived' then the files will be returned unarchived if there is only one file, and zipped if there are multiple files.",
    "required": true,
    "css": "todo",
    "type": "StringChoiceWidget",
    "details": {
      "values": [
        "zip",
        "unarchived"
      ],
      "columns": 2,
      "labels": {
        "zip": "Zip",
        "unarchived": "Unarchived (if single file, zipped if multiple files)"
      },
      "default": [
        "zip"
      ]
    },
    "id": "download_format"
  },
