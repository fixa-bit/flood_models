[
  {
    "name": "system_version",
    "label": "System version",
    "help": "System version is the version number of the GloFAS system. Choose 'Operational' for accessing datasets from the official system maintained 24/7 into operations. Details on system version can be found in the documentation under 'GloFAS versioning system'.",
    "required": true,
    "css": "todo",
    "type": "StringListArrayWidget",
    "details": {
      "groups": [
        {
          "label": "Operational",
          "open": true,
          "values": [
            "version_4_0"
          ],
          "labels": {
            "version_4_0": "Version 4.0"
          },
          "columns": 4
        },
        {
          "label": "Legacy",
          "open": false,
          "values": [
            "version_3_1",
            "version_2_2"
          ],
          "labels": {
            "version_3_1": "Version 3.1",
            "version_2_2": "Version 2.2"
          },
          "columns": 4
        }
      ],
      "displayaslist": false,
      "accordionGroups": true,
      "accordionOptions": {
        "searchable": false,
        "openGroups": [
          "Operational"
        ]
      },
      "default": [
        "version_4_0"
      ]
    },
    "id": "system_version"
  },
